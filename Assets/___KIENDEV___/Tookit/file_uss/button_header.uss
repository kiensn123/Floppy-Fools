


.button-style {
    background-color: transparent;
    color: white;
    border-width: 0;
    margin: 0 60px;
    -unity-font-style: bold;
    border-radius: 5px;
    padding: 5px;
    transition: translate 0.1s ease-in-out;

}

.button-style:hover {
    translate: 0 5px;
    scale: 1.1;
}

.button_Menu {
    background-color: rgba(0, 0, 0, 0.31);
    color: white;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.54);
    border-radius: 5px;
    transition: translate 0.2s ease-in-out;
}

.button_Menu:hover {
    background-color: rgba(0, 0, 0, 0.64);
    border-color: rgba(0, 0, 0, 0.71);
    translate: 5px 0;
}

.tieu_de {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin: 0;
}
